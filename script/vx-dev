#!/usr/bin/env bash

# Dev-server launcher, backed by Turborepo.
#
# Each app frontend's `start` script delegates here (via
# `pnpm -w vx-dev <app>`), which runs `turbo watch` over the frontend's Vite dev
# server and the backend service, rebuilding/restarting on dependency changes.
#
# Run from the workspace root (via `pnpm -w`), so relative paths resolve there.

set -euo pipefail

core_only=false
app=""
for arg in "$@"; do
  case "${arg}" in
    --core-only) core_only=true ;;
    -*)
      echo "vx-dev: unknown option: ${arg}" >&2
      exit 1
      ;;
    *) app="${arg}" ;;
  esac
done

if [[ -z "${app}" ]]; then
  echo "vx-dev: no app specified" >&2
  exit 1
fi

# Derive the machine type from the frontend package's `vx.env`.
fe_pkg_json="apps/${app}/frontend/package.json"
if [[ ! -f "${fe_pkg_json}" ]]; then
  echo "vx-dev: no frontend package at ${fe_pkg_json}" >&2
  exit 1
fi
machine="$(node -e "process.stdout.write(String((require('./${fe_pkg_json}').vx?.env?.VX_MACHINE_TYPE) ?? ''))")"
if [[ -n "${machine}" ]]; then
  export VX_MACHINE_TYPE="${machine}"
fi

fe="@votingworks/${app}-frontend"
be="@votingworks/${app}-backend"
if [[ "${core_only}" == true ]]; then
  exec turbo watch "${fe}#dev:server"
fi
exec turbo watch "${fe}#dev:server" "${be}#dev"
