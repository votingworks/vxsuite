{
  "name": "@votingworks/mark-scan-accessible-controller",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "rm -rf build && cargo build --release --offline --target-dir target && mkdir -p build && cp target/release/controllerd build/",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build target",
    "install:rust-addon": "cargo fetch"
  },
  "packageManager": "pnpm@12.16.1"
}
