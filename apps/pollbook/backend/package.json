{
  "name": "@votingworks/pollbook-backend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "bin",
    "Makefile",
    "schema.sql",
    "intermediate-scripts"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "format": "prettier '**/*.+(js|jsx|ts|tsx|css|graphql|json|less|md|mdx|sass|scss|yaml|yml)' --write",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "start": "node ./build/index.js",
    "test": "TZ=America/Anchorage vitest",
    "test:run": "TZ=America/Anchorage vitest run",
    "type-check": "tsc --build",
    "dev": "pnpm start"
  },
  "dependencies": {
    "@types/luxon": "^3.0.0",
    "@votingworks/auth": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/db": "workspace:*",
    "@votingworks/dev-dock-backend": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/networking": "workspace:*",
    "@votingworks/printing": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/usb-drive": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "canvas": "2.11.2",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0",
    "debug": "4.3.4",
    "express": "4.18.2",
    "fs-extra": "11.1.1",
    "helmet": "^8.1.0",
    "jsbarcode": "^3.11.6",
    "luxon": "^3.0.0",
    "nanoid": "^3.3.7",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "styled-components": "^5.3.11",
    "vitest": "^4.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.7",
    "@types/debug": "4.1.12",
    "@types/express": "4.17.14",
    "@types/fs-extra": "11.0.1",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/styled-components": "^5.1.26",
    "@types/tmp": "0.2.4",
    "@types/yargs": "17.0.22",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "esbuild": "0.28.1",
    "eslint-plugin-vx": "workspace:*",
    "jest-image-snapshot": "^6.4.0",
    "sort-package-json": "^1.50.0",
    "tmp": "^0.2.6",
    "yargs": "17.7.1"
  },
  "packageManager": "pnpm@10.34.5"
}
