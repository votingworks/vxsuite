{
  "name": "@votingworks/print-backend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "Makefile",
    "schema.sql"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "rm -rf build && tsc -p tsconfig.build.json && ./scripts/copy_build_assets.sh",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "dev": "NODE_ENV=development pnpm start",
    "format": "oxfmt --write",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm -w vx-task deps $npm_package_name && pnpm type-check:self && eslint --cache . --fix",
    "lint:self": "pnpm type-check:self && eslint --cache .",
    "start": "node ./build/index.js",
    "test": "pnpm -w vx-task build $npm_package_name && TZ=America/Anchorage vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "TZ=America/Anchorage vitest run",
    "type-check:self": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@votingworks/auth": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/db": "workspace:*",
    "@votingworks/dev-dock-backend": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/printing": "workspace:*",
    "@votingworks/test-decks": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/usb-drive": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "express": "4.22.0",
    "react": "18.3.1",
    "styled-components": "^5.3.11",
    "vitest": "5.0.2"
  },
  "devDependencies": {
    "@types/express": "4.17.14",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "24.19.2",
    "@types/react": "18.3.3",
    "@types/styled-components": "^5.1.26",
    "@vitest/coverage-istanbul": "5.0.2",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "copyfiles": "^2.4.1",
    "esbuild": "0.28.1",
    "eslint-plugin-vx": "workspace:*",
    "jest-image-snapshot": "^6.4.0",
    "sort-package-json": "^1.50.0"
  },
  "packageManager": "pnpm@12.16.1"
}
