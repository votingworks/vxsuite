{
  "name": "@votingworks/admin-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "files": [
    "build",
    "Makefile",
    "prodserver"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "pnpm type-check && vite build",
    "build:stubs": "script/build-stubs fs:src/stubs/fs.ts os:src/stubs/os.ts jsdom:src/stubs/jsdom.ts",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "format": "prettier '**/*.+(js|jsx|ts|tsx|css|graphql|json|less|md|mdx|sass|scss|yaml|yml)' --write",
    "lint": "pnpm type-check && eslint --cache . && pnpm stylelint:run",
    "lint:fix": "pnpm type-check && eslint --cache . --fix && pnpm stylelint:run:fix",
    "start": "VX_MACHINE_TYPE=admin turbo watch @votingworks/admin-frontend#dev:server @votingworks/admin-backend#dev",
    "stylelint:run": "stylelint 'src/**/*.{js,jsx,ts,tsx}' && stylelint 'src/**/*.css' --config .stylelintrc-css.cjs",
    "stylelint:run:fix": "stylelint 'src/**/*.{js,jsx,ts,tsx}' --fix && stylelint 'src/**/*.css' --config .stylelintrc-css.cjs --fix",
    "test": "TZ=America/Anchorage vitest",
    "test:run": "TZ=America/Anchorage vitest run",
    "type-check": "tsc --build",
    "dev:server": "vite --clearScreen false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "4.32.1",
    "@tanstack/react-query-devtools": "4.32.1",
    "@votingworks/basics": "workspace:*",
    "@votingworks/dev-dock-frontend": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "assert": "^2.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "debug": "4.3.4",
    "events": "3.3.0",
    "fetch-mock": "9.11.0",
    "fs-extra": "11.1.1",
    "history": "4.10.1",
    "http-proxy-middleware": "3.0.7",
    "jsdom": "20.0.1",
    "luxon": "^3.0.0",
    "path": "^0.12.7",
    "pluralize": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "10.4.1",
    "react-router-dom": "^5.3.4",
    "resolve": "1.18.1",
    "setimmediate": "^1.0.5",
    "stream-browserify": "^3.0.0",
    "styled-components": "^5.3.11",
    "util": "^0.12.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/connect": "^3.4.35",
    "@types/debug": "4.1.12",
    "@types/fetch-mock": "^7.3.2",
    "@types/history": "4.7.11",
    "@types/kiosk-browser": "workspace:*",
    "@types/luxon": "^3.0.0",
    "@types/node": "20.19.43",
    "@types/pluralize": "^0.0.29",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/readable-stream": "2.3.9",
    "@types/styled-components": "^5.1.26",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^1.3.2",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/admin-backend": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/grout-test-utils": "workspace:*",
    "@votingworks/monorepo-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "@votingworks/usb-drive": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "express": "4.18.2",
    "pdfjs-dist": "5.4.296",
    "sort-package-json": "^1.50.0",
    "vite": "8.0.16",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5",
  "vx": {
    "env": {
      "VX_MACHINE_TYPE": "admin"
    },
    "isBundled": true,
    "services": [
      "../backend"
    ]
  }
}
