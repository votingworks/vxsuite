{
  "name": "@votingworks/design-backend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "bin"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:prod": "pnpm --filter-prod $npm_package_name... build:self",
    "build:self": "tsc --build tsconfig.build.json",
    "cancel-background-task": "pnpm build:self && node ./build/scripts/cancel_background_task.js",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "create-jurisdiction": "pnpm build:self && node ./build/scripts/create_jurisdiction.js",
    "create-jurisdiction-user": "pnpm build:self && node ./build/scripts/create_jurisdiction_user.js",
    "create-organization": "pnpm build:self && node ./build/scripts/create_organization.js",
    "create-organization-user": "pnpm build:self && node ./build/scripts/create_organization_user.js",
    "create-support-user": "pnpm build:self && node ./build/scripts/create_support_user.js",
    "db:migrations:ci-validate": "./scripts/ci-validate-migrations.sh",
    "db:migrations:create": "node-pg-migrate create --ignore-pattern '\\..*|.*\\.json'",
    "db:migrations:run": "node-pg-migrate up --ignore-pattern '\\..*|.*\\.json'",
    "db:migrations:run-dev": "DATABASE_URL='postgres://design:design@localhost:5432/design' pnpm db:migrations:run",
    "db:migrations:undo-last": "node-pg-migrate down --ignore-pattern '\\..*|.*\\.json'",
    "db:migrations:undo-last-dev": "DATABASE_URL='postgres://design:design@localhost:5432/design' pnpm db:migrations:undo-last",
    "db:psql-dev": "psql 'postgres://design:design@localhost:5432/design'",
    "db:reset-dev": "./scripts/db_reset_dev.sh",
    "db:schema": "pg_dump --schema-only -d",
    "db:schema-dev": "pg_dump --schema-only 'postgres://design:design@localhost:5432/design'",
    "dev": "NODE_ENV=development pnpm start",
    "format": "prettier '**/*.+(js|jsx|ts|tsx|css|graphql|json|less|md|mdx|sass|scss|yaml|yml)' --write",
    "insert-dev-data": "pnpm build:self && node ./build/scripts/insert_dev_data.js",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "list-jurisdictions": "pnpm build:self && node ./build/scripts/list_jurisdictions.js",
    "list-organizations": "pnpm build:self && node ./build/scripts/list_organizations.js",
    "list-user-jurisdictions": "pnpm build:self && node ./build/scripts/list_user_jurisdictions.js",
    "mock-circleci-server": "pnpm build:self && node ./build/scripts/mock_circleci_server.js",
    "send-welcome-email": "pnpm build:self && node ./build/scripts/send_welcome_email.js",
    "start": "./scripts/start.sh",
    "start-with-mock-circleci": "./scripts/start-with-mock-circleci.sh",
    "test": "pnpm -w vx-task build $npm_package_name && TZ=America/Anchorage vitest",
    "test:ci": "pnpm -w vx-task test:ci $npm_package_name",
    "test:ci:self": "pnpm db:migrations:ci-validate && TZ=America/Anchorage ./scripts/test_ci.sh",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "TZ=America/Anchorage vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.735.0",
    "@aws-sdk/s3-request-presigner": "^3.738.0",
    "@sentry/node": "^8.51.0",
    "@votingworks/auth": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/printing": "workspace:*",
    "@votingworks/test-decks": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "auth0": "4.17.0",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0",
    "debug": "4.3.4",
    "express": "4.18.2",
    "express-openid-connect": "2.17.1",
    "fs-extra": "11.1.1",
    "jszip": "^3.9.1",
    "nanoid": "^3.3.7",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "tmp": "^0.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/express": "4.17.14",
    "@types/fs-extra": "11.0.1",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "24.13.3",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.3",
    "@types/tmp": "0.2.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/ballot-interpreter": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/test-decks": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "jest-image-snapshot": "^6.4.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
