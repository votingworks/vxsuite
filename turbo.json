{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.shared.json",
    "vitest.config.shared.mts",
    ".prettierrc.js",
    "stylelint.shared.js"
  ],
  "tasks": {
    "build:self": {
      "dependsOn": ["^build:self"],
      "env": ["REACT_APP_*"],
      "outputs": ["build/**", "*.node"]
    },
    "type-check": {
      "dependsOn": ["^build:self"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build:self"]
    },
    "test:run": {
      "dependsOn": ["build:self"],
      "passThroughEnv": ["VX_TEST_WORKERS"]
    },
    "test:ci": {
      "dependsOn": ["build:self"],
      "passThroughEnv": ["VX_TEST_WORKERS"]
    },
    "clean:self": {
      "cache": false
    },
    "dev:server": {
      "dependsOn": ["^build:self"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "dependsOn": ["build:self"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["*"]
    }
  }
}
