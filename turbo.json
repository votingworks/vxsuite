{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build:self": {
      "dependsOn": ["^build:self"],
      "outputs": ["build/**", "*.node"]
    },
    "type-check": {
      "dependsOn": ["^build:self"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build:self"]
    },
    "test:run": {
      "dependsOn": ["build:self"]
    },
    "test:ci": {
      "dependsOn": ["build:self"]
    },
    "clean:self": {
      "cache": false
    },
    "dev:server": {
      "dependsOn": ["^build:self"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "dependsOn": ["build:self"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["*"]
    }
  }
}
