{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "globalDependencies": [
    ".cargo/config.toml",
    ".env",
    ".env.production",
    ".node-version",
    ".nvmrc",
    "package.json",
    "rust-toolchain.toml",
    "script/vx-cargo-build",
    "tsconfig.shared.json",
    "types/**",
    "vitest.config.shared.mts",
    ".oxfmtrc.jsonc",
    "stylelint.shared.js"
  ],
  // Identifies the toolchain the artifacts were built with (in CI, the Docker
  // image tag). Native addons and `tsc` output depend on it, but none of it is
  // visible in the file inputs, so a cache shared across toolchains would
  // otherwise replay artifacts built by a different compiler.
  "globalEnv": ["VX_TOOLCHAIN_ID"],
  // turbo hides other environment variables from tasks. The trusted build sets
  // this so every cargo build uses only crates fetched beforehand.
  "globalPassThroughEnv": ["CARGO_NET_OFFLINE"],
  "noUpdateNotifier": true,
  "tasks": {
    "build:self": {
      "dependsOn": ["^build:self"],
      "env": ["VX_HUB_IMAGE", "REACT_APP_*"],
      "outputLogs": "new-only",
      "outputs": ["build/**", "*.node"]
    },
    "type-check:self": {
      "dependsOn": ["^build:self"],
      "outputLogs": "new-only",
      "outputs": []
    },
    "lint:self": {
      "dependsOn": ["^build:self"],
      "outputLogs": "new-only"
    },
    "test:run:self": {
      "dependsOn": ["build:self"],
      // `CI` switches on coverage (and its thresholds) and the junit reporter
      // in vitest.config.shared.mts, so it has to be part of the hash.
      "env": ["CI"],
      "outputs": ["reports/**"],
      "passThroughEnv": ["VX_TEST_WORKERS"]
    },
    "test:ci:self": {
      "dependsOn": ["build:self"],
      "env": ["CI"],
      "outputs": ["reports/**"],
      "passThroughEnv": ["VX_TEST_WORKERS"]
    },
    "clean:self": {
      "cache": false
    },
    "dev:server": {
      "dependsOn": ["^build:self"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "dependsOn": ["build:self"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": ["*"]
    }
  }
}
