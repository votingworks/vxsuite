{
  "compilerOptions": {
    // Allow use of newer APIs since we're in recent enough versions of
    // NodeJS/Electron.
    "target": "es2025",

    // Browser and Node packages share this config, so every package sees the
    // DOM types; ESLint's `no-restricted-globals` keeps browser-only globals
    // out of non-browser packages.
    "lib": ["dom", "dom.iterable", "esnext"],

    // TypeScript 7 changed the `types` default from automatically including all
    // installed `@types/*` packages to an empty list. Restore the previous
    // behavior of picking up ambient type packages (e.g. `@types/node`)
    // automatically.
    "types": ["*"],

    // Enable all strict mode checks
    "strict": true,

    // Compile modules independently for non-`tsc` tooling
    "isolatedModules": true,

    // Make it easier for non-`tsc` tooling to use `imports` as-is.
    "verbatimModuleSyntax": true,

    // Only allow TS syntax that can become JS by deleting types.
    "erasableSyntaxOnly": true,

    // Don't allow both e.g. "foo.ts" and "Foo.ts" for the same file.
    "forceConsistentCasingInFileNames": true,

    // Require `[…]` and not dots for accessing index properties.
    "noPropertyAccessFromIndexSignature": true,

    // Treat `[…]` property accesses as potentially undefined.
    "noUncheckedIndexedAccess": true,

    // Disallow falling through non-empty `switch` cases.
    "noFallthroughCasesInSwitch": true,

    // Node ESM/CJS module semantics; frontends override with `esnext`/`bundler`.
    "module": "node20",

    // Allow importing JSON files.
    "resolveJsonModule": true,

    // Use the automatic React 17+ JSX runtime.
    "jsx": "react-jsx",

    // Type-check only; `tsconfig.build.json` files re-enable emit.
    "noEmit": true,

    // Don't type-check `.d.ts` files from dependencies.
    "skipLibCheck": true
  }
}
