{
  "name": "@votingworks/exercises",
  "version": "1.0.0",
  "private": true,
  "description": "Code exercises",
  "license": "GPL-3.0-only",
  "scripts": {
    "coverage-check": "cargo run --quiet --release --package coverage-check -- check .",
    "build": "pnpm type-check",
    "clean": "echo 'Nothing to clean'",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "pnpm test:coverage",
    "test:coverage": "vitest run --coverage && pnpm coverage-check",
    "test:watch": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@types/node": "20.17.31",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/basics": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "is-ci-cli": "2.2.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
