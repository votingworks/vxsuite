{
  "name": "@votingworks/message-coder",
  "version": "1.0.0",
  "description": "Encode and decode messages for binary communication.",
  "keywords": [],
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm --filter $npm_package_name... clean:self",
    "clean:self": "rm -rf build",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-istanbul": "^4.1.6",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "is-ci-cli": "2.2.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
