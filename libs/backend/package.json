{
  "name": "@votingworks/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Data manipulation utilities for NodeJS",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build",
    "intermediate-scripts"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && TZ=America/Anchorage vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "TZ=America/Anchorage vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^5.0.1",
    "@google-cloud/translate": "^8.0.2",
    "@votingworks/auth": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/db": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/logging-utils": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/usb-drive": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "buffer": "^6.0.3",
    "dotenv": "16.3.1",
    "dotenv-expand": "9.0.0",
    "luxon": "^3.0.0",
    "micromatch": "^4.0.8",
    "node-html-parser": "^6.1.13",
    "readline": "^1.3.0",
    "stream-chopper": "^3.0.1",
    "tmp": "^0.2.6",
    "usb": "2.15.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/lodash.set": "^4.3.7",
    "@types/luxon": "^3.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "24.13.3",
    "@types/stream-chopper": "workspace:*",
    "@types/tmp": "0.2.4",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "lodash.set": "^4.3.2",
    "memory-streams": "^0.1.3",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
