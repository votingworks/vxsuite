{
  "extends": ["plugin:vx/recommended"],
  "rules": {
    // Allow for variable naming with "CVR"
    "vx/gts-identifiers": [
      "error",
      { "allowedNames": ["/CVR.*/", "/buildCVR.*/"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/xk3_client.ts"],
      "rules": {
        // Allow bitwise operations for HID report bitmask extraction
        "no-bitwise": "off"
      }
    }
  ]
}
