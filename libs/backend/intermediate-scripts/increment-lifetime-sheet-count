#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo 'Usage: increment-lifetime-sheet-count <file>'
}

if ! [[ "${#}" -eq 1 ]]; then
  usage >&2
  exit 1
fi

case "${1}" in
-h | --help)
  usage
  exit 0
  ;;
esac

sheet_count_file="${1}"

# `sudo` always sets `SUDO_USER`, so callers can't bypass this when elevating.
if [[ -n "${SUDO_USER:-}" && "${sheet_count_file}" != /vx/config/lifetime-sheet-count ]]; then
  echo "error: refusing to write to file via sudo: ${sheet_count_file} (expected /vx/config/lifetime-sheet-count)" >&2
  exit 1
fi

sheet_count_dir="$(dirname "${sheet_count_file}")"

# Lock dir (held until exit) not the file since it's replaced by `mv` below.
exec 9<"${sheet_count_dir}"
flock --exclusive --timeout 10 9

# Only allow digits so `$(( … ))` below doesn't evaluate the contents as code.
sheet_count=0
if [[ -e "${sheet_count_file}" ]]; then
  sheet_count=$(<"${sheet_count_file}")
  if ! [[ "${sheet_count}" =~ ^[0-9]+$ ]]; then
    echo "error: corrupt count in ${sheet_count_file}" >&2
    exit 1
  fi
fi

# Ensure there's always a valid count in the file, whether old or new.
sheet_count_file_tmp="${sheet_count_file}.tmp"
echo $((sheet_count + 1)) >"${sheet_count_file_tmp}"
sync "${sheet_count_file_tmp}"
mv "${sheet_count_file_tmp}" "${sheet_count_file}"
sync "${sheet_count_dir}"
