{
  "name": "@votingworks/grout",
  "version": "0.1.0",
  "private": true,
  "description": "A library to create type-safe RPC glue code.",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "cross-fetch": "^3.1.5",
    "debug": "4.3.4",
    "luxon": "^3.0.0"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/express": "4.17.14",
    "@types/luxon": "^3.0.0",
    "@vitest/coverage-istanbul": "5.0.0",
    "@votingworks/coverage-check": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "expect-type": "^0.15.0",
    "express": "4.18.2",
    "sort-package-json": "^1.50.0",
    "vitest": "5.0.0",
    "wait-for-expect": "^3.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}
