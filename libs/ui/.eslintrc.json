{
  "extends": [
    "plugin:vx/react",
    "plugin:storybook/recommended" // Recommended rules for *.stories.ts[x] files used by storybook.js.
  ],
  "rules": {
    "vx/gts-jsdoc": "off"
  },
  "overrides": [
    {
      // Test-only interop shim. It lives in `src/` rather than `test/` because
      // `accessible_controllers/test_utils.tsx` is compiled into the build and
      // so cannot import from outside `rootDir`.
      "files": ["src/user_event.ts"],
      "rules": {
        "import/no-extraneous-dependencies": "off"
      }
    }
  ]
}
