{
  "name": "@votingworks/pdi-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Scanner interface for the PDI PageScan 6",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:rust-addon": "cargo build --release --offline",
    "build:self": "pnpm build:rust-addon && pnpm build:ts",
    "build:ts": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "cargo clean --release --package pdi-scanner && rm -rf build",
    "install:rust-addon": "cargo fetch",
    "lint": "turbo run lint:self --filter=$npm_package_name --",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "turbo run build:self --filter=$npm_package_name && vitest",
    "test:run": "turbo run test:run:self --filter=$npm_package_name --",
    "test:run:self": "pnpm test:rust-addon && vitest run",
    "test:rust-addon": "cargo test",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/types": "workspace:*",
    "debug": "4.3.4",
    "xstate": "^4.33.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "20.19.43",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/test-utils": "workspace:*",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
