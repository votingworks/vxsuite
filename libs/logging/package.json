{
  "name": "@votingworks/logging",
  "version": "1.0.0",
  "private": true,
  "description": "Utilities and definitions for logging in votingworks components",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:generate-docs": "pnpm esr --cache ./scripts/generate_documentation.ts",
    "build:generate-rust-types": "pnpm esr --cache ./scripts/generate_rust_enums_from_toml.ts",
    "build:generate-types": "pnpm build:generate-typescript-types && pnpm build:generate-rust-types",
    "build:generate-typescript-types": "pnpm esr --cache ./scripts/generate_types_from_toml.ts",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "install:rust-addon": "cargo fetch",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "TZ=America/Anchorage vitest",
    "test:run": "TZ=America/Anchorage vitest run && pnpm build:generate-typescript-types --check && pnpm build:generate-rust-types --check",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@votingworks/basics": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "debug": "4.3.4",
    "stream": "^0.0.3",
    "yargs": "17.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/kiosk-browser": "workspace:*",
    "@types/node": "20.19.43",
    "@types/yargs": "17.0.22",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
