{
  "name": "@votingworks/logging",
  "version": "1.0.0",
  "private": true,
  "description": "Utilities and definitions for logging in votingworks components",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:generate-docs": "pnpm build && pnpm build:generate-docs:self",
    "build:generate-docs:self": "node ./build/scripts/generate_documentation.js",
    "build:generate-rust-types": "pnpm build && pnpm build:generate-rust-types:self",
    "build:generate-rust-types:self": "node ./build/scripts/generate_rust_enums_from_toml.js",
    "build:generate-types": "pnpm build:generate-typescript-types && pnpm build:generate-rust-types",
    "build:generate-typescript-types": "pnpm build && pnpm build:generate-typescript-types:self",
    "build:generate-typescript-types:self": "node ./build/scripts/generate_types_from_toml.js",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "install:rust-addon": "cargo fetch",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && TZ=America/Anchorage vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "pnpm build:generate-typescript-types:self --check && pnpm build:generate-rust-types:self --check && TZ=America/Anchorage vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@votingworks/basics": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "debug": "4.3.4",
    "yargs": "17.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/kiosk-browser": "workspace:*",
    "@types/node": "24.13.3",
    "@types/yargs": "17.0.22",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "esbuild": "0.28.1",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
