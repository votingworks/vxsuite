{
  "name": "@votingworks/fixture-generators",
  "version": "1.0.0",
  "description": "Generators for election data test fixtures",
  "keywords": [],
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cvr-fixture-generator": "bin/generate-cvrs"
  },
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "generate-cvr-fixtures": "pnpm build:self && ./bin/generate-cvr-fixtures",
    "generate-election-packages": "pnpm build:self && ./bin/regenerate-election-packages",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/auth": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "csv-stringify": "^6.4.0",
    "debug": "4.3.4",
    "esbuild": "0.28.1",
    "jszip": "^3.9.1",
    "nanoid": "^3.3.7",
    "tmp": "^0.2.6",
    "yargs": "17.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "24.13.3",
    "@types/tmp": "0.2.4",
    "@types/yargs": "17.0.22",
    "@vitest/coverage-istanbul": "5.0.0",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "tmp": "^0.2.6",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
