#!/usr/bin/env node

// Runs the compiled output; run `pnpm build:self` first.
import { main } from '../build/cli/generate-election-package/index.js';

const exitCode = await main(process.argv, {
  stdin: process.stdin,
  stdout: process.stdout,
  stderr: process.stderr,
});

// `main` awaits all of its file writes, but the Google Cloud auth internals
// can leave a keep-alive socket that holds the process open indefinitely, so
// exit explicitly once stdout/stderr have drained.
await Promise.all(
  [process.stdout, process.stderr].map(
    (stream) => new Promise((resolve) => stream.write('', resolve))
  )
);
process.exit(exitCode);
