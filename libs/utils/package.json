{
  "name": "@votingworks/utils",
  "version": "1.0.0",
  "private": true,
  "description": "Utilities for the monorepo.",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "TZ=America/Anchorage pnpm test:coverage",
    "test:coverage": "TZ=America/Anchorage vitest --coverage",
    "test:run": "TZ=America/Anchorage vitest run",
    "test:watch": "TZ=America/Anchorage vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/types": "workspace:*",
    "buffer": "^6.0.3",
    "debug": "4.3.4",
    "jszip": "^3.9.1",
    "luxon": "^3.0.0",
    "randombytes": "^2.1.0",
    "readline": "^1.3.0",
    "tmp": "^0.2.6",
    "yargs": "17.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/kiosk-browser": "workspace:*",
    "@types/luxon": "^3.0.0",
    "@types/node": "20.19.43",
    "@types/randombytes": "^2.0.0",
    "@types/tmp": "0.2.4",
    "@types/yargs": "17.0.22",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "fetch-mock": "9.11.0",
    "is-ci-cli": "2.2.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
