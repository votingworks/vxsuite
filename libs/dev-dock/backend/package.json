{
  "name": "@votingworks/dev-dock-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the overlaid dock UI for interacting with hardware mocks and other dev tools.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/auth": "workspace:*",
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/fujitsu-thermal-printer": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/pdi-scanner": "workspace:*",
    "@votingworks/printing": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/usb-drive": "workspace:*",
    "@votingworks/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "4.17.14",
    "@types/node": "20.19.43",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "express": "4.18.2",
    "fast-check": "2.23.2",
    "is-ci-cli": "2.2.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
