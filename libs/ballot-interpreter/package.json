{
  "name": "@votingworks/ballot-interpreter",
  "version": "1.0.0",
  "private": true,
  "description": "Interpreter for scanned ballot images",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build",
    "index.js",
    "index.d.ts",
    "dts-header.d.ts",
    "*.node"
  ],
  "scripts": {
    "benchmark": "cd benchmarks && vitest",
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:rust-addon": "napi build --platform --release",
    "build:self": "pnpm build:rust-addon && pnpm build:ts",
    "build:ts": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "cargo clean --release --package ballot-interpreter && rm -rf build",
    "install:rust-addon": "cargo fetch",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "vitest",
    "test:run": "pnpm test:rust-addon && vitest run",
    "test:rust-addon": "cargo test",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/ballot-encoder": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "better-sqlite3": "8.2.0",
    "canvas": "2.11.2",
    "debug": "4.3.4",
    "node-quirc": "^2.2.1",
    "tmp": "^0.2.6",
    "zedbar": "^0.5.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/better-sqlite3": "7.6.3",
    "@types/debug": "4.1.12",
    "@types/fs-extra": "11.0.1",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "20.19.43",
    "@types/node-quirc": "workspace:*",
    "@types/tmp": "0.2.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/bmd-ballot-fixtures": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "fs-extra": "11.1.1",
    "jest-image-snapshot": "^6.4.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "napi": {
    "binaryName": "ballot-interpreter",
    "dtsHeaderFile": "./dts-header.d.ts",
    "targets": [
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
