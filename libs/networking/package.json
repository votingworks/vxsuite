{
  "name": "@votingworks/networking",
  "version": "1.0.0",
  "private": true,
  "description": "Shared networking utilities for avahi service discovery and publishing",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "intermediate-scripts"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint . --fix",
    "lint:self": "pnpm type-check && eslint .",
    "pre-commit": "lint-staged",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/backend": "workspace:*",
    "debug": "4.3.4"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "20.19.43",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/test-utils": "workspace:*",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "lint-staged": "11.0.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
