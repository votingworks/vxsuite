{
  "name": "@votingworks/design-store-pg",
  "version": "1.0.0",
  "private": true,
  "description": "VxHub's PostgreSQL election design store, migrations and design API method builders",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "migrations"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint . --fix",
    "lint:self": "pnpm type-check && eslint .",
    "pre-commit": "lint-staged",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run --passWithNoTests",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/design-backend": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "debug": "4.3.4",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "24.19.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-istanbul": "5.0.2",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "lint-staged": "11.0.0",
    "sort-package-json": "^1.50.0",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
