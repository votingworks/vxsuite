{
  "name": "eslint-plugin-vx",
  "version": "1.0.0",
  "description": "VotingWorks monorepo rules for ESLint",
  "keywords": [],
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run",
    "type-check": "tsc --build",
    "type-check:watch": "tsc --build --watch"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "comment-parser": "^1.4.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@typescript-eslint/rule-tester": "8.70.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@votingworks/coverage-check": "workspace:*",
    "eslint": "9.39.5",
    "react": "18.3.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
