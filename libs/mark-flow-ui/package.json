{
  "name": "@votingworks/mark-flow-ui",
  "version": "1.0.0",
  "private": true,
  "description": "UI components for the VxMark voter mark flow",
  "license": "GPL-3.0-only",
  "author": "VotingWorks <eng@voting.works>",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "is-ci build:ci build:dev",
    "build:ci": "pnpm --filter $npm_package_name... --sequential build:self",
    "build:dev": "pnpm --filter $npm_package_name... build:self",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm --filter $npm_package_name... clean:self",
    "clean:self": "rm -rf build && tsc --build --clean tsconfig.build.json",
    "lint": "pnpm type-check && eslint --cache . && pnpm stylelint:run",
    "lint:fix": "pnpm type-check && eslint --cache . --fix && pnpm stylelint:run:fix",
    "start": "storybook dev -p 6060",
    "stylelint:run": "stylelint 'src/**/*.{js,jsx,ts,tsx}'",
    "stylelint:run:fix": "stylelint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "debug": "4.3.4",
    "lodash.camelcase": "^4.3.0",
    "react-router-dom": "^5.3.4",
    "use-interval": "1.4.0"
  },
  "devDependencies": {
    "@storybook/cli": "^7.2.2",
    "@storybook/react": "^7.2.2",
    "@tanstack/react-query": "4.32.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/debug": "4.1.12",
    "@types/history": "4.7.11",
    "@types/lodash.camelcase": "^4.3.6",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.26",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/monorepo-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "assert": "^2.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "esbuild": "0.28.1",
    "eslint-plugin-storybook": "^0.6.10",
    "eslint-plugin-vx": "workspace:*",
    "events": "3.3.0",
    "history": "4.10.1",
    "is-ci-cli": "2.2.0",
    "jsdom": "20.0.1",
    "path": "^0.12.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sort-package-json": "^1.50.0",
    "stream-browserify": "^3.0.0",
    "styled-components": "^5.3.11",
    "util": "^0.12.4",
    "vite": "8.0.16",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.11"
  },
  "packageManager": "pnpm@10.34.5"
}
