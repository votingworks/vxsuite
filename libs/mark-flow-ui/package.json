{
  "name": "@votingworks/mark-flow-ui",
  "version": "1.0.0",
  "private": true,
  "description": "UI components for the VxMark voter mark flow",
  "license": "GPL-3.0-only",
  "author": "VotingWorks <eng@voting.works>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "lint": "turbo run lint:self --filter=$npm_package_name --",
    "lint:fix": "pnpm type-check && eslint --cache . --fix && pnpm stylelint:run:fix",
    "lint:self": "pnpm type-check && eslint --cache . && pnpm stylelint:run",
    "stylelint:run": "stylelint 'src/**/*.{js,jsx,ts,tsx}'",
    "stylelint:run:fix": "stylelint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "test": "turbo run build:self --filter=$npm_package_name && vitest",
    "test:run": "turbo run test:run:self --filter=$npm_package_name --",
    "test:run:self": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "lodash.camelcase": "^4.3.0",
    "react-router-dom": "^5.3.4",
    "use-interval": "1.4.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "4.32.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/history": "4.7.11",
    "@types/lodash.camelcase": "^4.3.6",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.26",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/monorepo-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "assert": "^2.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "esbuild": "0.28.1",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-vx": "workspace:*",
    "events": "3.3.0",
    "history": "4.10.1",
    "jsdom": "20.0.1",
    "path": "^0.12.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sort-package-json": "^1.50.0",
    "stream-browserify": "^3.0.0",
    "styled-components": "^5.3.11",
    "util": "^0.12.4",
    "vite": "8.0.16",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.11"
  },
  "packageManager": "pnpm@10.34.5"
}
