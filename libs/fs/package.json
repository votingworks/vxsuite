{
  "name": "@votingworks/fs",
  "version": "1.0.0",
  "private": true,
  "description": "File system utilities for VotingWorks projects",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "lint": "turbo run lint:self --filter=$npm_package_name --",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "lint:self": "pnpm type-check && eslint --cache .",
    "test": "turbo run build:self --filter=$npm_package_name && vitest",
    "test:run": "turbo run test:run:self --filter=$npm_package_name --",
    "test:run:self": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "buffer": "^6.0.3",
    "micromatch": "^4.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "20.19.43",
    "@types/tmp": "0.2.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "memory-streams": "^0.1.3",
    "sort-package-json": "^1.50.0",
    "tmp": "^0.2.6",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
