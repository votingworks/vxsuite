{
  "name": "@votingworks/fs",
  "version": "1.0.0",
  "private": true,
  "description": "File system utilities for VotingWorks projects",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "files": [
    "build",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "is-ci build:ci build:dev",
    "build:ci": "pnpm --filter $npm_package_name... --sequential build:self",
    "build:dev": "pnpm --filter $npm_package_name... build:self",
    "build:rust-addon": "napi build --platform --release",
    "build:self": "pnpm build:rust-addon && pnpm build:ts",
    "build:ts": "tsc --build tsconfig.build.json",
    "clean": "pnpm --filter $npm_package_name... clean:self",
    "clean:self": "cargo clean --release --package vx-fs && rm -rf build",
    "install:rust-addon": "cargo fetch",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "pnpm build && vitest run --coverage",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "buffer": "^6.0.3",
    "micromatch": "^4.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/debug": "4.1.12",
    "@types/node": "20.19.43",
    "@types/tmp": "0.2.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "fast-check": "2.23.2",
    "is-ci-cli": "2.2.0",
    "memory-streams": "^0.1.3",
    "sort-package-json": "^1.50.0",
    "tmp": "^0.2.6",
    "vitest": "^4.1.6"
  },
  "napi": {
    "binaryName": "vx-fs",
    "targets": [
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
