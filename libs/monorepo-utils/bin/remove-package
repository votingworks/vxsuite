#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(dirname "${BASH_SOURCE[0]}")"
cd "$bin_dir/../../.."

if ! out="$(pnpm exec turbo run build:self --filter=@votingworks/monorepo-utils 2>&1)"; then
  printf '%s\n' "$out" >&2
  exit 1
fi

exec node libs/monorepo-utils/build/bin/remove_package.js "$@"
