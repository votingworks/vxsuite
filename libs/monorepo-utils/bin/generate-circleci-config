#!/usr/bin/env node

// @ts-check

require('esbuild-runner').install({
  type: 'transform',
});

const { join } = require('path');
const { generateAllConfigs } = require('../src/circleci');
const { getWorkspacePackageInfo } = require('../src/pnpm');
const { writeFileSync } = require('fs');

const workspaceRoot = join(__dirname, '..', '..', '..');

async function main() {
  const packageInfo = getWorkspacePackageInfo(workspaceRoot);
  // MOON_CI_PROTOTYPE=1 emits a slim config that runs only the experimental
  // moon-ci job (skipping the ~60 per-package jobs) while iterating on the moon
  // migration.
  //
  // MOON_JOBS_MAIN_ONLY=1 restricts the (non-blocking) moon jobs in the full
  // config to the `main` branch. It defaults off while we're iterating so the
  // jobs run on every branch; flip it on once the moon config is stable.
  const configs = generateAllConfigs(packageInfo, {
    moonPrototype: Boolean(process.env.MOON_CI_PROTOTYPE),
    moonJobsMainOnly: Boolean(process.env.MOON_JOBS_MAIN_ONLY),
  });
  for (const [filePath, fileContents] of configs.entries()) {
    console.log(`Writing CircleCI config to ${filePath}`);
    writeFileSync(filePath, fileContents);
  }
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
