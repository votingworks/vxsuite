# In production, this include is replaced with `.include /etc/ssl/openssl.default.cnf` to avoid a
# circular dependency. See src/intermediate-scripts/manage-openssl-config for more details.
.include /etc/ssl/openssl.cnf

# VotingWorks's custom cert fields
[ new_oids ]
component    = 1.3.6.1.4.1.59817.1
jurisdiction = 1.3.6.1.4.1.59817.2
cardType     = 1.3.6.1.4.1.59817.3
electionId   = 1.3.6.1.4.1.59817.4
electionDate = 1.3.6.1.4.1.59817.5
machineId    = 1.3.6.1.4.1.59817.6

# Extensions for the short-lived TLS leaf certs that machines sign for their peer API
[ v3_tls_leaf ]
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature
extendedKeyUsage = serverAuth, clientAuth

# Extensions for the strongSwan (IPsec) machine cert, which only identifies the machine during IKE
[ v3_ipsec_end_entity ]
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature
extendedKeyUsage = 1.3.6.1.5.5.7.3.17
