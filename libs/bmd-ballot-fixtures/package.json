{
  "name": "@votingworks/bmd-ballot-fixtures",
  "version": "1.0.0",
  "private": true,
  "description": "Renders BMD ballot fixture PDFs",
  "license": "GPL-3.0-only",
  "author": "VotingWorks <eng@voting.works>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix && pnpm stylelint:run:fix",
    "lint:self": "pnpm type-check && eslint --cache . && pnpm stylelint:run",
    "stylelint:run": "stylelint 'src/**/*.{js,jsx,ts,tsx}'",
    "stylelint:run:fix": "stylelint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "test": "pnpm -w vx-task build $npm_package_name && TZ=America/Anchorage vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "TZ=America/Anchorage vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@types/tmp": "0.2.4",
    "@votingworks/basics": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "@votingworks/printing": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "tmp": "^0.2.6"
  },
  "devDependencies": {
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/react": "18.3.3",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "jest-image-snapshot": "^6.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sort-package-json": "^1.50.0",
    "util": "^0.12.4",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "packageManager": "pnpm@10.34.5"
}
