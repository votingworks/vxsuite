{
  "name": "@votingworks/election-definition-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Election definition components shared by VxHub and VxAdmin",
  "license": "GPL-3.0-only",
  "author": "VotingWorks <eng@voting.works>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm type-check && eslint --cache . --fix && pnpm stylelint:run:fix",
    "lint:self": "pnpm type-check && eslint --cache . && pnpm stylelint:run",
    "stylelint:run": "stylelint 'src/**/*.{js,jsx,ts,tsx}'",
    "stylelint:run:fix": "stylelint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run --passWithNoTests",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "@votingworks/election-definition-backend": "workspace:*",
    "@votingworks/grout": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "react-router-dom": "^5.3.4",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "4.32.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/history": "4.7.11",
    "@types/node": "24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/sanitize-html": "^2.13.0",
    "@types/styled-components": "^5.1.26",
    "@vitest/coverage-istanbul": "5.0.2",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/grout-test-utils": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "history": "4.10.1",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.11",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "4.32.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.11"
  },
  "packageManager": "pnpm@12.16.1"
}
