{
  "name": "@votingworks/cdf-schema-builder",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "cdf-schema-builder": "bin/cdf-schema-builder"
  },
  "files": [
    "bin",
    "build"
  ],
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "turbo run clean:self --filter=$npm_package_name...",
    "clean:self": "rm -rf build",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "jsdom": "20.0.1",
    "json-schema": "^0.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "20.0.0",
    "@types/json-schema": "^7.0.9",
    "@types/node": "20.19.43",
    "@vitest/coverage-istanbul": "^4.1.6",
    "eslint-plugin-vx": "workspace:*",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5"
}
