{
  "name": "@votingworks/cdf-schema-builder",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "cdf-schema-builder": "bin/cdf-schema-builder"
  },
  "files": [
    "bin",
    "build"
  ],
  "scripts": {
    "build": "is-ci build:ci build:dev",
    "build:ci": "pnpm --filter $npm_package_name... --sequential build:self",
    "build:dev": "pnpm --filter $npm_package_name... build:self",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm --filter $npm_package_name... clean:self",
    "clean:self": "rm -rf build && tsc --build --clean tsconfig.build.json",
    "coverage-check": "cargo run --quiet --release --package coverage-check -- check . --never-scan ../../libs/basics/src",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "pnpm test:coverage",
    "test:coverage": "vitest run --coverage && pnpm coverage-check",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/basics": "workspace:*",
    "jsdom": "20.0.1",
    "json-schema": "^0.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "20.0.0",
    "@types/json-schema": "^7.0.9",
    "@types/node": "20.17.31",
    "@vitest/coverage-istanbul": "^4.1.6",
    "eslint-plugin-vx": "workspace:*",
    "is-ci-cli": "2.2.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5"
}
