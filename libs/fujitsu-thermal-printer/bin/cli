#!/usr/bin/env node

// Runs compiled output: the esbuild-runner require hook can't be used from an
// ES module, and it resolves `.js` specifiers literally so it never finds the
// `.ts` sources. Run `pnpm build` first.
import { main } from '../build/cli.js';

try {
  process.exitCode = await main();
} catch (error) {
  console.error(error);
  process.exit(1);
}
