{
  "name": "@votingworks/election-definition-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Election definition logic and design API contract shared by VxHub and VxAdmin",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./election-package": {
      "types": "./build/election_package/index.d.ts",
      "default": "./build/election_package/index.js"
    },
    "./test-utils": {
      "types": "./build/test_utils.d.ts",
      "default": "./build/test_utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm -w vx-task build $npm_package_name",
    "build:self": "rm -rf build && tsc -p tsconfig.build.json",
    "clean": "pnpm -w vx-task clean $npm_package_name",
    "clean:self": "rm -rf build",
    "lint": "pnpm -w vx-task lint $npm_package_name",
    "lint:fix": "pnpm -w vx-task deps $npm_package_name && pnpm type-check:self && eslint --cache . --fix",
    "lint:self": "pnpm type-check:self && eslint --cache .",
    "test": "pnpm -w vx-task build $npm_package_name && vitest",
    "test:run": "pnpm -w vx-task test:run $npm_package_name",
    "test:run:self": "vitest run --passWithNoTests",
    "type-check:self": "rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@types/archiver": "8.0.0",
    "@votingworks/basics": "workspace:*",
    "@votingworks/hmpb": "workspace:*",
    "@votingworks/types": "workspace:*",
    "archiver": "8.0.0",
    "nanoid": "^3.3.20",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-istanbul": "5.0.2",
    "@votingworks/coverage-check": "workspace:*",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "eslint-plugin-vx": "workspace:*",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.16.1"
}
