#!/usr/bin/env node

// Runs the compiled output rather than transpiling `src` on the fly: the
// esbuild-runner hook this used to go through is a CommonJS `require` hook and
// cannot load this package's ESM sources. Run `pnpm build:self` first.
import { main } from '../build/cli/driver_cli.js';

main()
  .then((code) => {
    process.exitCode = code;
  })
  .catch((error) => {
    console.error(error);
    process.exit(1);
  });
