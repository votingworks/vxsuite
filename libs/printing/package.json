{
  "name": "@votingworks/printing",
  "version": "1.0.0",
  "private": true,
  "description": "Backend rendering, printing, and printer management",
  "license": "GPL-3.0-only",
  "main": "build/index.js",
  "types": "build/index.d.js",
  "scripts": {
    "build": "turbo run build:self --filter=$npm_package_name",
    "build:self": "tsc --build tsconfig.build.json",
    "clean": "pnpm --filter $npm_package_name... clean:self",
    "clean:self": "rm -rf build",
    "generate-m404n-ppd": "./scripts/generate-m404n-ppd",
    "postinstall": "test -f /usr/bin/chromium || playwright install --with-deps chromium",
    "lint": "pnpm type-check && eslint --cache .",
    "lint:fix": "pnpm type-check && eslint --cache . --fix",
    "test": "is-ci test:ci test:watch",
    "test:ci": "pnpm build && TZ=America/Anchorage pnpm vitest run --coverage",
    "test:coverage": "TZ=America/Anchorage vitest --coverage",
    "test:run": "TZ=America/Anchorage vitest run",
    "test:watch": "TZ=America/Anchorage vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@votingworks/backend": "workspace:*",
    "@votingworks/basics": "workspace:*",
    "@votingworks/fs": "workspace:*",
    "@votingworks/logging": "workspace:*",
    "@votingworks/test-utils": "workspace:*",
    "@votingworks/types": "workspace:*",
    "@votingworks/ui": "workspace:*",
    "@votingworks/utils": "workspace:*",
    "debug": "4.3.4",
    "pdf-lib": "^1.17.1",
    "playwright": "1.55.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.11",
    "tmp": "^0.2.6",
    "tmp-promise": "^3.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "^5.1.26",
    "@types/tmp": "0.2.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "@votingworks/fixtures": "workspace:*",
    "@votingworks/image-utils": "workspace:*",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint-plugin-vx": "workspace:*",
    "is-ci-cli": "2.2.0",
    "jest-image-snapshot": "^6.4.0",
    "sort-package-json": "^1.50.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5"
}
