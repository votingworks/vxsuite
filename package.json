{
  "name": "vxsuite",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "turbo run build:self",
    "clean": "turbo run clean:self",
    "clean-all": "git clean -dfX",
    "configure-env": "libs/utils/bin/configure-env",
    "configure-vxdev-env": "libs/utils/bin/configure-env --isVxDev -o /vx/config/.env.local",
    "generate-circleci-config": "libs/monorepo-utils/bin/generate-circleci-config",
    "lint": "turbo run lint",
    "prepare": "husky install",
    "shellcheck": "script/shellcheck",
    "test": "VX_TEST_WORKERS=2 turbo run test:run --concurrency=50% --filter=!@votingworks/exercises",
    "type-check": "turbo run type-check",
    "update-snapshots": "script/update-snapshots"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^7.2.2",
    "@storybook/addon-actions": "^7.2.2",
    "@storybook/addon-backgrounds": "^7.2.2",
    "@storybook/addon-docs": "^7.2.2",
    "@storybook/addon-essentials": "^7.2.2",
    "@storybook/addon-interactions": "^7.2.2",
    "@storybook/addon-links": "^7.2.2",
    "@storybook/addon-measure": "^7.2.2",
    "@storybook/addon-outline": "^7.2.2",
    "@storybook/addons": "^7.2.2",
    "@storybook/blocks": "^7.2.2",
    "@storybook/builder-vite": "^7.2.2",
    "@storybook/channel-postmessage": "^7.2.2",
    "@storybook/channel-websocket": "^7.2.2",
    "@storybook/cli": "^7.2.2",
    "@storybook/client-api": "^7.2.2",
    "@storybook/core-common": "^7.2.2",
    "@storybook/manager-api": "^7.2.2",
    "@storybook/preview-api": "^7.2.2",
    "@storybook/preview-web": "^7.2.2",
    "@storybook/react": "^7.2.2",
    "@storybook/react-vite": "^7.2.2",
    "@storybook/theming": "^7.2.2",
    "@storybook/types": "^7.2.2",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "husky": "^7.0.0",
    "lint-staged": "^15.0.0",
    "postcss-styled-syntax": "^0.4.0",
    "prettier": "^3.0.3",
    "sort-package-json": "^1.50.0",
    "storybook": "^7.2.2",
    "stylelint": "^15.10.2",
    "stylelint-config-standard": "^34.0.0",
    "turbo": "2.10.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@babel/traverse": "7.23.2",
      "brace-expansion@1": "^1.1.13",
      "brace-expansion@2": "^2.0.2",
      "graceful-fs": "^4.2.9",
      "nan": "^2.20.0",
      "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "patchedDependencies": {
      "@fortawesome/react-fontawesome@3.5.0": "patches/@fortawesome__react-fontawesome@3.5.0.patch"
    }
  }
}
