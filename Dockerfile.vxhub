# Docker Image for VxHub deployments.

# [TODO](https://github.com/votingworks/vxsuite/issues/6261): Might be better to
# build in CI and push to the Heroku container registry.
FROM debian:bookworm-slim

WORKDIR /vx/code/vxsuite
COPY .nvmrc package.json ./

RUN apt-get update && apt-get install -y --no-install-recommends \
  # Build deps:
  curl \
  # Runtime deps:
  ca-certificates \
  ghostscript \
  libpcsclite1 \
  unzip \
  zip \
  # Node/PNPM:
  && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash && \
  . ~/.bashrc && \
  nvm install && \
  node -v && \
  npm i -g pnpm@12.16.1 && \
  pnpm -v

COPY . .
ENV HOME="/root" NODE_ENV="production" VX_HUB_IMAGE="1"
RUN ./script/vxhub-prod-build
